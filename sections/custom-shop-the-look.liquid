<script>
  let activeProductData = null;

  // Open Quick View Modal with Real Product Data
  function openLoomhausModal(card) {
    if (!card) return;
    const modal = document.getElementById('loomhausQuickViewModal');
    if (!modal) return;

    // Check if card contains real product JSON
    const jsonScript = card.querySelector('.loomhaus-product-json');
    if (jsonScript) {
      try {
        activeProductData = JSON.parse(jsonScript.textContent);
      } catch(e) {
        activeProductData = null;
      }
    } else {
      activeProductData = null;
    }

    const titleElem = document.getElementById('loomhausModalTitle');
    const priceElem = document.getElementById('loomhausModalPrice');
    const descElem = document.getElementById('loomhausModalDesc');
    const imgElem = document.getElementById('loomhausModalImg');
    const btnElem = document.getElementById('loomhausAddToCartBtn');

    if (activeProductData) {
      // Populate with REAL product data
      titleElem.textContent = activeProductData.title;
      priceElem.textContent = activeProductData.price;
      descElem.textContent = activeProductData.description;

      // Initial image: always use featured/first image (e.g. black bag)
      const initialImg = (activeProductData.images && activeProductData.images[0]) || activeProductData.image || card.getAttribute('data-image');
      if (initialImg && imgElem) {
        imgElem.src = initialImg;
      }

      btnElem.setAttribute('data-variant-id', activeProductData.selected_variant_id || (activeProductData.variants[0] && activeProductData.variants[0].id) || '');
      
      // Build dynamic options if options exist (removes size if bag product)
      buildDynamicModalOptions(activeProductData);

      // Trigger option change to ensure initial active swatch (Black) syncs variant and image
      onModalOptionChange();
    } else {
      // Fallback from card data attributes
      const title = card.getAttribute('data-title');
      const price = card.getAttribute('data-price');
      const desc = card.getAttribute('data-desc');
      const image = card.getAttribute('data-image');
      const variantId = card.getAttribute('data-variant-id');

      if (title) titleElem.textContent = title;
      if (price) priceElem.textContent = price;
      if (desc) descElem.textContent = desc;
      if (image && imgElem) imgElem.src = image;
      if (variantId) btnElem.setAttribute('data-variant-id', variantId);

      // Hide size group if title is a bag
      const sizeGroup = document.getElementById('loomhausSizeGroup');
      if (sizeGroup) {
        if (title && title.toLowerCase().includes('bag')) {
          sizeGroup.style.display = 'none';
        } else {
          sizeGroup.style.display = '';
        }
      }
    }

    modal.classList.add('loomhaus-modal--open');
    modal.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  // Dynamic Options Builder for Real Products
  function buildDynamicModalOptions(prodData) {
    const container = document.getElementById('loomhausModalOptionsContainer');
    if (!container || !prodData.options || prodData.options.length === 0) return;

    const isBag = (prodData.title && prodData.title.toLowerCase().includes('bag')) ||
                  (prodData.type && prodData.type.toLowerCase().includes('bag'));

    // Check if real product has options
    if (prodData.options && prodData.options.length > 0) {
      let optionsHtml = '';
      prodData.options.forEach((opt, idx) => {
        const optName = opt.name.toLowerCase();
        const isColor = optName.includes('color') || optName.includes('colour');
        const isSize = optName.includes('size');

        // As requested: remove size selection feature for bag products!
        if (isBag && isSize) {
          return;
        }

        optionsHtml += `<div class="loomhaus-modal__option-group">`;
        optionsHtml += `<label class="loomhaus-modal__option-label">${opt.name.toUpperCase()}</label>`;

        if (isColor) {
          optionsHtml += `<div class="loomhaus-modal__swatches">`;
          opt.values.forEach((val, vIdx) => {
            const activeClass = vIdx === 0 ? 'loomhaus-modal__swatch-btn--active' : '';
            const valLower = val.toLowerCase();
            const bgDot = valLower.includes('white') ? '#FFFFFF; border: 1px solid #CCC;' : 
                          valLower.includes('black') ? '#191B18;' : 
                          valLower.includes('navy') || valLower.includes('blue') ? '#1B2A4A;' : 
                          valLower.includes('olive') || valLower.includes('green') ? '#5A6652;' : '#999999;';
            optionsHtml += `
              <button type="button" class="loomhaus-modal__swatch-btn ${activeClass}" data-opt-idx="${idx}" data-val="${val}" onclick="selectColorSwatch(this)">
                <span class="loomhaus-modal__swatch-dot" style="background-color: ${bgDot}"></span>
                <span>${val}</span>
              </button>`;
          });
          optionsHtml += `</div>`;
        } else {
          optionsHtml += `<div class="loomhaus-modal__select-wrap">`;
          optionsHtml += `<select class="loomhaus-modal__select" data-opt-idx="${idx}" onchange="onModalOptionChange()">`;
          opt.values.forEach((val, vIdx) => {
            optionsHtml += `<option value="${val}" ${vIdx === 0 ? 'selected' : ''}>${val}</option>`;
          });
          optionsHtml += `</select><span class="loomhaus-modal__select-arrow">&#x25BE;</span></div>`;
        }
        optionsHtml += `</div>`;
      });
      container.innerHTML = optionsHtml;
    }
  }

  // Handle color swatch selection
  function selectColorSwatch(btn) {
    const parent = btn.closest('.loomhaus-modal__swatches') || document.getElementById('loomhausModalColors');
    if (parent) {
      parent.querySelectorAll('.loomhaus-modal__swatch-btn').forEach(b => b.classList.remove('loomhaus-modal__swatch-btn--active'));
    }
    btn.classList.add('loomhaus-modal__swatch-btn--active');

    // Handle fallback mode when real product data isn't embedded
    const val = btn.getAttribute('data-val');
    if (!activeProductData) {
      const modalImg = document.getElementById('loomhausModalImg');
      if (modalImg && val) {
        const valLower = val.toLowerCase();
        if (valLower.includes('white')) {
          modalImg.src = "{{ 'white-bag-modal.jpg' | asset_url }}";
        } else if (valLower.includes('black')) {
          modalImg.src = "{{ 'black-bag-card.jpg' | asset_url }}";
        }
      }

      const titleElem = document.getElementById('loomhausModalTitle');
      if (titleElem && val) {
        let currentTitle = titleElem.textContent;
        const valLower = val.toLowerCase();
        if (valLower.includes('white')) {
          currentTitle = currentTitle.replace(/\bBlack\b/gi, 'White').replace(/\bblack\b/g, 'white');
        } else if (valLower.includes('black')) {
          currentTitle = currentTitle.replace(/\bWhite\b/gi, 'Black').replace(/\bwhite\b/g, 'black');
        }
        titleElem.textContent = currentTitle;
      }
    }

    onModalOptionChange();
  }

  // Find matching variant based on selected options and switch image
  function onModalOptionChange() {
    if (!activeProductData || !activeProductData.variants) return;

    // Collect currently selected options
    const selectedOptions = [];
    const container = document.getElementById('loomhausModalOptionsContainer');
    
    // Check swatches
    let selectedColor = '';
    const activeSwatch = container.querySelector('.loomhaus-modal__swatch-btn--active');
    if (activeSwatch) {
      const idx = parseInt(activeSwatch.getAttribute('data-opt-idx'), 10);
      selectedColor = activeSwatch.getAttribute('data-val');
      selectedOptions[idx] = selectedColor;
    }

    // Check selects
    container.querySelectorAll('.loomhaus-modal__select').forEach(sel => {
      const idx = parseInt(sel.getAttribute('data-opt-idx'), 10);
      selectedOptions[idx] = sel.value;
    });

    // Find matching variant
    let matched = activeProductData.variants.find(v => {
      return v.options.every((val, i) => selectedOptions[i] === undefined || selectedOptions[i] === val);
    });

    if (!matched && selectedColor) {
      matched = activeProductData.variants.find(v => {
        return v.options.some(val => val.toLowerCase() === selectedColor.toLowerCase());
      });
    }

    if (!matched) {
      matched = activeProductData.variants[0];
    }

    // UPDATE IMAGE TO MATCH SELECTED COLOR!
    const modalImg = document.getElementById('loomhausModalImg');
    if (modalImg) {
      let targetImg = null;

      // 1. If the matched variant has an assigned image, use it
      if (matched && matched.image) {
        targetImg = matched.image;
      }
      
      // 2. If not, match by color keyword from product images array
      if (!targetImg && selectedColor) {
        const colorLower = selectedColor.toLowerCase();
        if (colorLower.includes('white')) {
          if (activeProductData.images && activeProductData.images.length > 1) {
            targetImg = activeProductData.images[1];
          } else {
            targetImg = "{{ 'white-bag-modal.jpg' | asset_url }}";
          }
        } else if (colorLower.includes('black')) {
          if (activeProductData.images && activeProductData.images.length > 0) {
            targetImg = activeProductData.images[0];
          } else {
            targetImg = activeProductData.image || "{{ 'black-bag-card.jpg' | asset_url }}";
          }
        }
      }

      // 3. Fallback to activeProductData.image
      if (!targetImg) {
        targetImg = activeProductData.image;
      }

      if (targetImg) {
        modalImg.src = targetImg;
      }
    }

    // UPDATE TITLE TO MATCH SELECTED COLOR (e.g. Floral Black Top vs Floral White Top)
    const titleElem = document.getElementById('loomhausModalTitle');
    if (titleElem && activeProductData) {
      let currentTitle = activeProductData.title || activeProductData.base_title || '';
      if (selectedColor && currentTitle) {
        const colorLower = selectedColor.toLowerCase();
        if (colorLower.includes('white')) {
          currentTitle = currentTitle.replace(/\bBlack\b/gi, 'White').replace(/\bblack\b/g, 'white');
        } else if (colorLower.includes('black')) {
          currentTitle = currentTitle.replace(/\bWhite\b/gi, 'Black').replace(/\bwhite\b/g, 'black');
        }
      }
      titleElem.textContent = currentTitle;
    }

    if (matched) {
      document.getElementById('loomhausModalPrice').textContent = matched.price;
      const btn = document.getElementById('loomhausAddToCartBtn');
      btn.setAttribute('data-variant-id', matched.id);
      if (!matched.available) {
        document.getElementById('loomhausBtnText').textContent = 'SOLD OUT';
        btn.disabled = true;
      } else {
        document.getElementById('loomhausBtnText').textContent = 'ADD TO CART';
        btn.disabled = false;
      }
    }
  }

  // Close Quick View Modal
  function closeLoomhausModal() {
    const modal = document.getElementById('loomhausQuickViewModal');
    if (!modal) return;
    modal.classList.remove('loomhaus-modal--open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // When ADD TO CART / CHECKOUT is tapped in Image 2
  function triggerCheckoutFromModal() {
    const btn = document.getElementById('loomhausAddToCartBtn');
    const variantId = btn.getAttribute('data-variant-id');
    const originalText = document.getElementById('loomhausBtnText').textContent;

    if (variantId && variantId !== '') {
      document.getElementById('loomhausBtnText').textContent = 'ADDING...';
      btn.disabled = true;

      const rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
      
      // Perform REAL Shopify AJAX Add to Cart
      fetch(rootUrl + 'cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({
          id: parseInt(variantId, 10),
          quantity: 1
        })
      })
      .then(res => res.json())
      .then(cartItem => {
        document.getElementById('loomhausBtnText').textContent = originalText;
        btn.disabled = false;
        closeLoomhausModal();
        fetchRealCartData();
        setTimeout(openLoomhausCartDrawer, 200);
      })
      .catch(err => {
        console.log('Cart add error:', err);
        document.getElementById('loomhausBtnText').textContent = originalText;
        btn.disabled = false;
        closeLoomhausModal();
        setTimeout(openLoomhausCartDrawer, 200);
      });
    } else {
      // Demo fallback
      closeLoomhausModal();
      setTimeout(openLoomhausCartDrawer, 200);
    }
  }

  // Fetch real Shopify cart items
  function fetchRealCartData() {
    const rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
    fetch(rootUrl + 'cart.js')
      .then(res => res.json())
      .then(cart => {
        if (cart && cart.items && cart.items.length > 0) {
          renderLiveCartDrawer(cart);
        }
      })
      .catch(e => console.log('Cart fetch error:', e));
  }

  // Render real cart contents into Cart Drawer
  function renderLiveCartDrawer(cart) {
    const list = document.getElementById('loomhausCartItemsList');
    const countElem = document.getElementById('loomhausCartCount');
    const subtotalElem = document.getElementById('loomhausCartSubtotal');
    if (!list) return;

    if (countElem) countElem.textContent = cart.item_count;
    
    // Format money helper
    const formattedTotal = (cart.total_price / 100).toFixed(2);
    if (subtotalElem) subtotalElem.textContent = '₹' + formattedTotal;

    let itemsHtml = '';
    cart.items.forEach(item => {
      const itemPrice = (item.final_line_price / 100).toFixed(2);
      itemsHtml += `
        <div class="loomhaus-drawer-cart__item" data-key="${item.key}" data-price="${itemPrice}">
          <div class="loomhaus-drawer-cart__item-thumb">
            <img src="${item.image || './assets/cart-thumb-1.jpg'}" alt="${item.product_title}">
          </div>
          <div class="loomhaus-drawer-cart__item-details">
            <div class="loomhaus-drawer-cart__item-top">
              <span class="loomhaus-drawer-cart__item-name">${item.product_title}</span>
              <span class="loomhaus-drawer-cart__item-price">₹${itemPrice}</span>
            </div>
            <span class="loomhaus-drawer-cart__item-variant">${item.variant_title || ''}</span>
            <div class="loomhaus-drawer-cart__item-bottom">
              <div class="loomhaus-qty-picker">
                <button type="button" class="loomhaus-qty-btn" onclick="updateLiveItemQty('${item.key}', ${item.quantity - 1})">-</button>
                <span class="loomhaus-qty-val">${item.quantity}</span>
                <button type="button" class="loomhaus-qty-btn" onclick="updateLiveItemQty('${item.key}', ${item.quantity + 1})">+</button>
              </div>
              <button type="button" class="loomhaus-drawer-cart__remove" onclick="updateLiveItemQty('${item.key}', 0)">Remove</button>
            </div>
          </div>
        </div>
      `;
    });
    list.innerHTML = itemsHtml;
  }

  function updateLiveItemQty(key, newQty) {
    const rootUrl = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) ? window.Shopify.routes.root : '/';
    fetch(rootUrl + 'cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ id: key, quantity: newQty })
    })
    .then(res => res.json())
    .then(cart => {
      renderLiveCartDrawer(cart);
    });
  }

  // Open Cart Drawer (Image 3)
  function openLoomhausCartDrawer() {
    const drawer = document.getElementById('loomhausCartDrawer');
    if (!drawer) return;
    drawer.classList.add('loomhaus-drawer-cart--open');
    drawer.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  // Close Cart Drawer
  function closeLoomhausCartDrawer() {
    const drawer = document.getElementById('loomhausCartDrawer');
    if (!drawer) return;
    drawer.classList.remove('loomhaus-drawer-cart--open');
    drawer.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // Header cart trigger
  document.addEventListener('DOMContentLoaded', function() {
    const headerCart = document.getElementById('loomhaus-cart-icon');
    if (headerCart) {
      headerCart.addEventListener('click', function(e) {
        e.preventDefault();
        fetchRealCartData();
        openLoomhausCartDrawer();
      });
    }
  });

  // Quantity helpers for demo items
  function updateItemQty(btn, delta) {
    const valElem = btn.parentElement.querySelector('.loomhaus-qty-val');
    let qty = parseInt(valElem.textContent, 10) + delta;
    if (qty < 1) qty = 1;
    valElem.textContent = qty;
    recalculateCart();
  }

  function removeItem(btn) {
    const item = btn.closest('.loomhaus-drawer-cart__item');
    if (item) {
      item.remove();
      recalculateCart();
    }
  }

  function recalculateCart() {
    const items = document.querySelectorAll('.loomhaus-drawer-cart__item');
    let total = 0;
    let count = 0;
    items.forEach(item => {
      const price = parseFloat(item.getAttribute('data-price') || '0');
      const qty = parseInt(item.querySelector('.loomhaus-qty-val')?.textContent || '1', 10);
      total += price * qty;
      count += qty;
    });
    const subtotalElem = document.getElementById('loomhausCartSubtotal');
    if (subtotalElem) subtotalElem.textContent = '₹' + total.toFixed(2);
    const countElem = document.getElementById('loomhausCartCount');
    if (countElem) countElem.textContent = count;
  }
</script>

