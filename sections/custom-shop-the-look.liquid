  .loomhaus-qty-btn {
    background: #FFFFFF;
    border: none;
    width: 26px;
    height: 26px;
    cursor: pointer;
    font-size: 13px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #191B18;
    transition: background 0.15s ease;
  }

  .loomhaus-qty-btn:hover {
    background: #F0EDE8;
  }

  .loomhaus-qty-val {
    width: 26px;
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: #191B18;
  }

  .loomhaus-drawer-cart__remove {
    background: none;
    border: none;
    font-size: 11.5px;
    color: #888C82;
    cursor: pointer;
    padding: 0;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .loomhaus-drawer-cart__remove:hover {
    color: #191B18;
  }

  /* Drawer Footer */
  .loomhaus-drawer-cart__footer {
    padding: 20px 24px 24px;
    border-top: 1px solid #EFECE6;
    background: #FFFFFF;
  }

  .loomhaus-drawer-cart__subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 15px;
    font-weight: 700;
    color: #191B18;
    margin-bottom: 6px;
  }

  .loomhaus-drawer-cart__taxes-note {
    font-size: 11px;
    color: #8C9086;
    margin: 0 0 16px 0;
  }

  .loomhaus-drawer-cart__checkout-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 14px;
    border-radius: 8px;
    background: #222420;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .loomhaus-drawer-cart__checkout-btn:hover {
    background: #383C35;
  }

  .loomhaus-drawer-cart__checkout-arrow {
    transition: transform 0.2s ease;
  }

  .loomhaus-drawer-cart__checkout-btn:hover .loomhaus-drawer-cart__checkout-arrow {
    transform: translateX(4px);
  }

  /* Animations */
  @keyframes loomhausFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes loomhausScaleIn {
    from { transform: scale(0.95); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  @keyframes loomhausSlideInRight {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  /* Responsive */
  @media (max-width: 900px) {
    .loomhaus-stl__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
    .loomhaus-modal__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .loomhaus-modal__media {
      max-height: 240px;
    }
  }

  @media (max-width: 580px) {
    .loomhaus-stl__container {
      padding: 0 18px;
    }
    .loomhaus-stl__header {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    .loomhaus-stl__grid {
      grid-template-columns: 1fr;
    }
    .loomhaus-drawer-cart__panel {
      width: 100%;
      max-width: 100%;
    }
  }
</style>

