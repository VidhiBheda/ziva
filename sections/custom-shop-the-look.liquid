      <!-- Cart Item 2 -->
      <div class="loomhaus-drawer-cart__item" data-id="2" data-price="331.07">
        <div class="loomhaus-drawer-cart__item-thumb">
          <img src="{{ 'cart-thumb-2.jpg' | asset_url }}" alt="Ocean Blue Shirt" onerror="this.src='{{ 'look-1.jpg' | asset_url }}';">
        </div>
        <div class="loomhaus-drawer-cart__item-details">
          <div class="loomhaus-drawer-cart__item-top">
            <span class="loomhaus-drawer-cart__item-name">Ocean Blue Shirt</span>
            <span class="loomhaus-drawer-cart__item-price">₹331.07</span>
          </div>
          <span class="loomhaus-drawer-cart__item-variant">S / White</span>
          <div class="loomhaus-drawer-cart__item-bottom">
