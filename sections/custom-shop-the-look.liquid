              <button type="button" class="loomhaus-qty-btn" onclick="updateItemQty(this, -1)">-</button>
              <span class="loomhaus-qty-val">1</span>
              <button type="button" class="loomhaus-qty-btn" onclick="updateItemQty(this, 1)">+</button>
            </div>
            <button type="button" class="loomhaus-drawer-cart__remove" onclick="removeItem(this)">Remove</button>
          </div>
        </div>
      </div>

      <!-- Cart Item 3 (Auto-Added) -->
      <div class="loomhaus-drawer-cart__item" data-id="3" data-price="240.78">
        <div class="loomhaus-drawer-cart__item-thumb">
          <img src="{{ 'cart-thumb-3.jpg' | asset_url }}" alt="Soft Winter Jacket" onerror="this.src='{{ 'look-2.jpg' | asset_url }}';">
        </div>
        <div class="loomhaus-drawer-cart__item-details">
          <div class="loomhaus-drawer-cart__item-top">
            <div>
              <span class="loomhaus-badge-auto">AUTO-ADDED</span>
              <span class="loomhaus-drawer-cart__item-name">Soft Winter Jacket</span>
            </div>
            <span class="loomhaus-drawer-cart__item-price">₹240.78</span>
          </div>
          <span class="loomhaus-drawer-cart__item-variant">M / Black</span>
          <div class="loomhaus-drawer-cart__item-bottom">
            <div class="loomhaus-qty-picker">
              <button type="button" class="loomhaus-qty-btn" onclick="updateItemQty(this, -1)">-</button>
              <span class="loomhaus-qty-val">1</span>
              <button type="button" class="loomhaus-qty-btn" onclick="updateItemQty(this, 1)">+</button>
