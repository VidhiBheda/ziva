{%- style -%}
  #shopify-section-{{ section.id }} .loomhaus-stl {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-family: inherit;
  }

  #shopify-section-{{ section.id }} .loomhaus-stl__kicker {
    color: {{ section.settings.kicker_color }};
  }

  #shopify-section-{{ section.id }} .loomhaus-stl__heading {
    color: {{ section.settings.text_color }};
  }

  #shopify-section-{{ section.id }} .loomhaus-stl__card {
    border-radius: {{ section.settings.card_radius }}px;
  }
{%- endstyle -%}

{%- assign all_store_products = collections.all.products -%}

<section class="loomhaus-stl" data-section-id="{{ section.id }}">
  <div class="loomhaus-stl__container">
    
    <!-- Section Header -->
    <div class="loomhaus-stl__header">
      <div class="loomhaus-stl__header-left">
        {%- if section.settings.kicker != blank -%}
          <span class="loomhaus-stl__kicker">{{ section.settings.kicker }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="loomhaus-stl__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if section.settings.subtext != blank -%}
        <div class="loomhaus-stl__header-right">
          <p class="loomhaus-stl__subtext">{{ section.settings.subtext }}</p>
        </div>
      {%- endif -%}
    </div>

    <!-- Look Grid -->
    <div class="loomhaus-stl__grid" style="--stl-columns: {{ section.settings.columns_desktop }};">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign look_index = forloop.index
            assign default_image_name = 'look-' | append: look_index | append: '.jpg'
            
            # Resolve product: block setting takes precedence; auto-map from store products if unassigned
            assign prod = block.settings.product
            if prod == blank and all_store_products.size > forloop.index0
              assign prod = all_store_products[forloop.index0]
            endif

            # Resolve Product Title: dynamically sync color name if active variant or card is Black vs White
            if prod != blank
              assign look_title = prod.title

              # Color-sync Title: if the product title contains 'White' but the active/featured variant or card image is 'Black' (or vice versa), reflect the correct color
              assign is_black_first = false
              for opt in prod.options_with_values
                assign opt_name_lower = opt.name | downcase
                if opt_name_lower contains 'color' or opt_name_lower contains 'colour'
                  assign first_val_lower = opt.values.first | downcase
                  if first_val_lower contains 'black'
                    assign is_black_first = true
                  endif
                  break
                endif
              endfor

              if is_black_first or look_title contains 'Floral White Top'
                if look_title contains 'White'
                  assign look_title = look_title | replace: 'White', 'Black'
                elsif look_title contains 'white'
                  assign look_title = look_title | replace: 'white', 'black'
                endif
              endif
            else
              assign look_title = block.settings.title | default: 'Product Title'
              if look_title contains 'Floral White Top'
                assign look_title = look_title | replace: 'Floral White Top', 'Floral Black Top'
              endif
            endif

            # Resolve Product Price
            if prod != blank
              assign look_price = prod.price | money
              assign look_raw_price = prod.price
            else
              assign look_price = block.settings.price | default: '₹389.55'
              assign look_raw_price = 38955
            endif

            # Resolve Product Description
            if prod != blank and prod.description != blank
              assign look_desc = prod.description | strip_html | truncate: 160
            else
              assign look_desc = block.settings.description | default: 'Premium tailored apparel designed for effortless everyday style.'
            endif

            # Resolve Card Image: Priority to real product image unless merchant provided a custom look photo
            assign card_img = blank
            if block.settings.image != blank and block.settings.use_product_image == false
              assign card_img = block.settings.image
            elsif prod != blank and prod.featured_image != blank
              assign card_img = prod.featured_image
            elsif block.settings.image != blank
              assign card_img = block.settings.image
            endif

            # Resolve Modal Product Image: Default to product featured/first image (e.g. black bag)
            assign modal_img = blank
            if block.settings.modal_image != blank
              assign modal_img = block.settings.modal_image
            elsif prod != blank and prod.featured_image != blank
              assign modal_img = prod.featured_image
            elsif prod != blank and prod.media.size > 0
              assign modal_img = prod.media[0]
            elsif card_img != blank
              assign modal_img = card_img
            endif

            # Resolve Variant ID and availability
            if prod != blank
              assign variant_id = prod.selected_or_first_available_variant.id
              assign is_available = prod.available
            else
              assign variant_id = ''
              assign is_available = true
            endif
          -%}
          <div 
            class="loomhaus-stl__card" 
            {{ block.shopify_attributes }}
            data-index="{{ forloop.index0 }}"
            data-title="{{ look_title | escape }}"
            data-price="{{ look_price | escape }}"
            data-desc="{{ look_desc | escape }}"
            data-product-id="{% if prod != blank %}{{ prod.id }}{% endif %}"
            data-variant-id="{{ variant_id }}"
            data-available="{{ is_available }}"
            data-image="{% if modal_img != blank %}{{ modal_img | image_url: width: 700 }}{% elsif card_img != blank %}{{ card_img | image_url: width: 700 }}{% else %}{{ 'modal-product-jacket.jpg' | asset_url }}{% endif %}"
            data-product-url="{% if prod != blank %}{{ prod.url }}{% else %}{{ block.settings.custom_url | default: '#' }}{% endif %}"
          >
            <div class="loomhaus-stl__card-media">
              {%- if card_img != blank -%}
                <img 
                  src="{{ card_img | image_url: width: 700 }}" 
                  alt="{{ look_title | escape }}"
                  loading="lazy"
                  width="400"
                  height="490"
                  class="loomhaus-stl__card-img"
                >
              {%- else -%}
                <img 
                  src="{{ default_image_name | asset_url }}" 
                  alt="{{ look_title | escape }}"
                  loading="lazy"
                  width="400"
                  height="490"
                  class="loomhaus-stl__card-img"
                  onerror="this.src='{{ 'look-1.jpg' | asset_url }}';"
                >
              {%- endif -%}

              <!-- Interactive + Hotspot Button -->
              <button 
                type="button" 
                class="loomhaus-stl__hotspot" 
                style="top: {{ block.settings.hotspot_top }}%; left: {{ block.settings.hotspot_left }}%;"
                aria-label="Shop {{ look_title | escape }}"
                onclick="openLoomhausModal(this.closest('.loomhaus-stl__card'))"
              >
                <span class="loomhaus-stl__hotspot-icon" aria-hidden="true">+</span>
                <span class="loomhaus-stl__hotspot-pulse"></span>
              </button>

              <!-- Floating Bottom Label Pill -->
              <div class="loomhaus-stl__card-pill" onclick="openLoomhausModal(this.closest('.loomhaus-stl__card'))">
                <span class="loomhaus-stl__card-title">{{ look_title }}</span>
                <span class="loomhaus-stl__card-price">{{ look_price }}</span>
              </div>
            </div>

            <!-- Real Product JSON Data for Modal Options -->
            {%- if prod != blank -%}
              <script type="application/json" class="loomhaus-product-json">
                {
                  "id": {{ prod.id | json }},
                  "title": {{ look_title | json }},
                  "base_title": {{ prod.title | json }},
                  "type": {{ prod.type | default: '' | json }},
                  "price": {{ prod.price | money | json }},
                  "description": {{ look_desc | json }},
                  "image": {% if modal_img != blank %}{{ modal_img | image_url: width: 800 | json }}{% else %}{{ prod.featured_image | default: prod.media[0] | image_url: width: 800 | json }}{% endif %},
                  "url": {{ prod.url | json }},
                  "available": {{ prod.available | json }},
                  "selected_variant_id": {{ prod.selected_or_first_available_variant.id | json }},
                  "images": [
                    {%- for media in prod.media -%}
                      {{ media | image_url: width: 800 | json }}{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ],
                  "variants": [
                    {%- for variant in prod.variants -%}
                      {%- assign var_img = variant.featured_image | default: variant.image -%}
                      {
                        "id": {{ variant.id }},
                        "title": {{ variant.title | json }},
                        "price": {{ variant.price | money | json }},
                        "available": {{ variant.available }},
                        "options": {{ variant.options | json }},
                        "image": {% if var_img != blank %}{{ var_img | image_url: width: 800 | json }}{% else %}null{% endif %}
                      }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ],
                  "options": [
                    {%- for option in prod.options_with_values -%}
                      {
                        "name": {{ option.name | json }},
                        "position": {{ option.position }},
                        "values": {{ option.values | json }}
                      }{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  ]
                }
              </script>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

  </div>
</section>

<!-- ======================================================= -->
<!-- QUICK VIEW PRODUCT MODAL POPUP (Image 2) -->
<!-- ======================================================= -->
<div class="loomhaus-modal" id="loomhausQuickViewModal" aria-hidden="true" role="dialog" aria-modal="true">
  <div class="loomhaus-modal__backdrop" onclick="closeLoomhausModal()"></div>
  <div class="loomhaus-modal__dialog">
    <button type="button" class="loomhaus-modal__close" aria-label="Close modal" onclick="closeLoomhausModal()">
      &times;
    </button>
    
    <div class="loomhaus-modal__grid">
      <!-- Left: Real Product Studio Photo -->
      <div class="loomhaus-modal__media">
        <img 
          id="loomhausModalImg" 
          src="{{ 'modal-product-jacket.jpg' | asset_url }}" 
          alt="Product Photo"
          class="loomhaus-modal__img"
        >
      </div>

      <!-- Right: Real Product Info & Options -->
      <div class="loomhaus-modal__info">
        <h3 class="loomhaus-modal__title" id="loomhausModalTitle">Product Title</h3>
        <div class="loomhaus-modal__price" id="loomhausModalPrice">₹389.55</div>
        <p class="loomhaus-modal__description" id="loomhausModalDesc">
          Product description
        </p>

        <!-- Dynamic Product Options Container -->
        <div id="loomhausModalOptionsContainer">
          <!-- Color Selection -->
          <div class="loomhaus-modal__option-group" id="loomhausColorGroup">
            <label class="loomhaus-modal__option-label">COLOR</label>
            <div class="loomhaus-modal__swatches" id="loomhausModalColors">
              <button type="button" class="loomhaus-modal__swatch-btn loomhaus-modal__swatch-btn--active" data-val="Black" onclick="selectColorSwatch(this)">
                <span class="loomhaus-modal__swatch-dot" style="background-color: #191B18;"></span>
                <span>Black</span>
              </button>
              <button type="button" class="loomhaus-modal__swatch-btn" data-val="White" onclick="selectColorSwatch(this)">
                <span class="loomhaus-modal__swatch-dot" style="background-color: #FFFFFF; border: 1px solid #CCC;"></span>
                <span>White</span>
              </button>
            </div>
          </div>

          <!-- Size Selection -->
          <div class="loomhaus-modal__option-group" id="loomhausSizeGroup">
            <label class="loomhaus-modal__option-label" for="loomhausModalSizeSelect">SIZE</label>
            <div class="loomhaus-modal__select-wrap">
              <select id="loomhausModalSizeSelect" class="loomhaus-modal__select" onchange="onModalSizeChange(this)">
                <option value="S">S</option>
                <option value="M" selected>M</option>
                <option value="L">L</option>
                <option value="XL">XL</option>
              </select>
              <span class="loomhaus-modal__select-arrow" aria-hidden="true">&#x25BE;</span>
            </div>
          </div>
        </div>

        <!-- Add To Cart / Checkout Button -->
        <div class="loomhaus-modal__action">
          <button 
            type="button" 
            class="loomhaus-modal__btn" 
            id="loomhausAddToCartBtn"
            onclick="triggerCheckoutFromModal()"
          >
            <span id="loomhausBtnText">ADD TO CART</span>
            <span class="loomhaus-modal__btn-arrow" aria-hidden="true">&rarr;</span>
          </button>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- ======================================================= -->
<!-- SIDE CART DRAWER (Image 3) -->
<!-- ======================================================= -->
<div class="loomhaus-drawer-cart" id="loomhausCartDrawer" aria-hidden="true">
  <div class="loomhaus-drawer-cart__backdrop" onclick="closeLoomhausCartDrawer()"></div>
  <div class="loomhaus-drawer-cart__panel">
    
    <!-- Drawer Header -->
    <div class="loomhaus-drawer-cart__header">
