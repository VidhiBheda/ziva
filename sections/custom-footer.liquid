{%- style -%}
  #shopify-section-{{ section.id }} .loomhaus-footer {
    background-color: {{ section.settings.bg_color }};
    color: {{ section.settings.link_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-family: inherit;
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }

  #shopify-section-{{ section.id }} .loomhaus-footer__brand-title {
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .loomhaus-footer__tagline {
    color: {{ section.settings.link_color }};
  }

  #shopify-section-{{ section.id }} .loomhaus-footer__col-title {
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .loomhaus-footer__link {
    color: {{ section.settings.link_color }};
  }

  #shopify-section-{{ section.id }} .loomhaus-footer__link:hover {
    color: {{ section.settings.link_hover_color }};
  }
{%- endstyle -%}

<footer class="loomhaus-footer" data-section-id="{{ section.id }}">
  <div class="loomhaus-footer__container">
    
    <!-- Left Column: Brand & Tagline -->
    <div class="loomhaus-footer__brand">
      {%- if section.settings.logo != blank -%}
        <a href="{{ routes.root_url }}" class="loomhaus-footer__logo-link">
          <img 
            src="{{ section.settings.logo | image_url: width: 300 }}" 
            alt="{{ section.settings.brand_title | default: shop.name | escape }}"
            width="{{ section.settings.logo_width }}"
            loading="lazy"
            class="loomhaus-footer__logo-img"
          >
        </a>
      {%- else -%}
        <a href="{{ routes.root_url }}" class="loomhaus-footer__brand-title">
          {{ section.settings.brand_title | default: 'Loomhaus' }}
        </a>
      {%- endif -%}

      {%- if section.settings.brand_tagline != blank -%}
        <p class="loomhaus-footer__tagline">
          {{ section.settings.brand_tagline }}
        </p>
      {%- endif -%}
    </div>

    <!-- Right Columns: Navigation Menus -->
    <div class="loomhaus-footer__nav-groups">
      {%- for block in section.blocks -%}
        <div class="loomhaus-footer__col" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h3 class="loomhaus-footer__col-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}

          <ul class="loomhaus-footer__links">
            {%- if block.settings.menu != blank and linklists[block.settings.menu].links.size > 0 -%}
              {%- for link in linklists[block.settings.menu].links -%}
                <li class="loomhaus-footer__link-item">
                  <a href="{{ link.url }}" class="loomhaus-footer__link">{{ link.title | escape }}</a>
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- assign fallback_lines = block.settings.links_fallback | newline_to_br | split: '<br />' -%}
              {%- for line in fallback_lines -%}
                {%- assign item_text = line | strip -%}
                {%- if item_text != blank -%}
                  <li class="loomhaus-footer__link-item">
                    <a href="{{ routes.all_products_collection_url }}" class="loomhaus-footer__link">{{ item_text | escape }}</a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
          </ul>
        </div>
      {%- endfor -%}
    </div>

  </div>
</footer>

<style>
  .loomhaus-footer {
    width: 100%;
    position: relative;
    box-sizing: border-box;
  }

  .loomhaus-footer__container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 40px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 40px;
  }

  /* Left Brand */
  .loomhaus-footer__brand {
    flex: 0 1 440px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .loomhaus-footer__logo-link {
    display: inline-block;
    text-decoration: none;
    line-height: 1;
  }

  .loomhaus-footer__logo-img {
    height: auto;
    display: block;
  }

  .loomhaus-footer__brand-title {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    text-decoration: none;
    display: inline-block;
    transition: opacity 0.2s ease;
  }

  .loomhaus-footer__brand-title:hover {
    opacity: 0.9;
  }

  .loomhaus-footer__tagline {
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.45;
    margin: 12px 0 0 0;
    max-width: 360px;
  }

  /* Right Nav Columns */
  .loomhaus-footer__nav-groups {
    display: flex;
    align-items: flex-start;
    gap: 90px;
  }

  .loomhaus-footer__col {
    display: flex;
    flex-direction: column;
    min-width: 100px;
  }

  .loomhaus-footer__col-title {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin: 0 0 16px 0;
    line-height: 1.2;
  }

  .loomhaus-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .loomhaus-footer__link-item {
    margin: 0;
    padding: 0;
  }

  .loomhaus-footer__link {
    font-size: 13.5px;
    font-weight: 400;
    line-height: 1.35;
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-block;
  }

  /* Responsive Breakpoints */
  @media (max-width: 820px) {
    .loomhaus-footer__container {
      flex-direction: column;
      gap: 36px;
      padding: 0 24px;
    }

    .loomhaus-footer__nav-groups {
      gap: 60px;
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .loomhaus-footer__container {
      padding: 0 20px;
    }

    .loomhaus-footer__nav-groups {
      gap: 40px;
      flex-wrap: wrap;
    }
  }
</style>

{% schema %}
{
  "name": "Loomhaus Footer",
  "class": "loomhaus-footer-section",
  "tag": "footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand Info"
    },
    {
      "type": "text",
      "id": "brand_title",
      "label": "Brand Title",
      "default": "Loomhaus"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Brand Logo (optional)"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 240,
      "step": 10,
      "unit": "px",
      "label": "Logo width",
      "default": 130
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand Tagline",
      "default": "Clothes made to be worn for years, not seasons."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#292A26"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading / Brand color",
      "default": "#FAF7F2"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Tagline & Links color",
      "default": "#C7C3B9"
    },
    {
      "type": "color",
      "id": "link_hover_color",
      "label": "Links hover color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Top padding",
      "default": 55
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 5,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Navigation Column",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Column Heading",
          "default": "SHOP"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Select Navigation Menu"
        },
        {
          "type": "textarea",
          "id": "links_fallback",
          "label": "Fallback Links (one per line)",
          "default": "Women\nMen\nNew arrivals\nBestsellers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Loomhaus Footer",
      "blocks": [
        {
          "type": "menu_column",
          "settings": {
            "title": "SHOP",
            "links_fallback": "Women\nMen\nNew arrivals\nBestsellers"
          }
        },
        {
          "type": "menu_column",
          "settings": {
            "title": "HELP",
            "links_fallback": "Shipping\nReturns\nSize guide\nContact us"
          }
        }
      ]
    }
  ]
}
{% endschema %}
