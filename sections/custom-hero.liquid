{%- style -%}
  #shopify-section-{{ section.id }} .loomhaus-hero {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-family: inherit;
  }

  #shopify-section-{{ section.id }} .loomhaus-hero__badge {
    background-color: {{ section.settings.badge_bg }};
    color: {{ section.settings.badge_text_color }};
  }

  #shopify-section-{{ section.id }} .loomhaus-hero__heading {
    color: {{ section.settings.heading_color }};
  }

  #shopify-section-{{ section.id }} .loomhaus-hero__description {
    color: {{ section.settings.description_color }};
  }

  #shopify-section-{{ section.id }} .loomhaus-hero__btn {
    background-color: {{ section.settings.btn_bg }};
    color: {{ section.settings.btn_text_color }};
  }

  #shopify-section-{{ section.id }} .loomhaus-hero__btn:hover {
    background-color: {{ section.settings.btn_hover_bg }};
    color: {{ section.settings.btn_hover_text }};
  }

  #shopify-section-{{ section.id }} .loomhaus-hero__stat-value {
    color: {{ section.settings.stat_value_color }};
  }

  #shopify-section-{{ section.id }} .loomhaus-hero__stat-label {
    color: {{ section.settings.stat_label_color }};
  }

  #shopify-section-{{ section.id }} .loomhaus-hero__arch-composition {
    max-width: {{ section.settings.image_max_width }}px;
  }

  #shopify-section-{{ section.id }} .loomhaus-hero__arch-backdrop {
    background-color: {{ section.settings.backdrop_arch_color }};
    width: {{ section.settings.backdrop_size }}px;
    height: {{ section.settings.backdrop_size }}px;
    right: {{ section.settings.backdrop_offset_x }}px;
  }

  #shopify-section-{{ section.id }} .loomhaus-ticker {
    background-color: {{ section.settings.ticker_bg }};
    color: {{ section.settings.ticker_text }};
    padding-top: {{ section.settings.ticker_padding }}px;
    padding-bottom: {{ section.settings.ticker_padding }}px;
  }

  #shopify-section-{{ section.id }} .loomhaus-ticker__star {
    color: {{ section.settings.ticker_star_color }};
  }
{%- endstyle -%}

<section class="loomhaus-hero-wrapper" data-section-id="{{ section.id }}">
  <div class="loomhaus-hero">
    <div class="loomhaus-hero__container">
      
      <!-- Left Column: Content & Statistics -->
      <div class="loomhaus-hero__content">
        
        {%- if section.settings.show_badge and section.settings.badge_text != blank -%}
          <div class="loomhaus-hero__badge-wrapper">
            <span class="loomhaus-hero__badge">{{ section.settings.badge_text }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="loomhaus-hero__heading">
            {{ section.settings.heading }}
          </h1>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="loomhaus-hero__description">
            <p>{{ section.settings.description }}</p>
          </div>
        {%- endif -%}

        {%- if section.settings.btn_text != blank -%}
          <div class="loomhaus-hero__action">
            <a href="{{ section.settings.btn_link | default: routes.all_products_collection_url }}" class="loomhaus-hero__btn">
              <span>{{ section.settings.btn_text }}</span>
              <span class="loomhaus-hero__btn-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        {%- endif -%}

        <!-- Stats / Trust Metrics Grid -->
        {%- if section.settings.show_stats -%}
          <div class="loomhaus-hero__stats">
            {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
            {%- if stat_blocks.size > 0 -%}
              {%- for block in stat_blocks -%}
                <div class="loomhaus-hero__stat-item" {{ block.shopify_attributes }}>
                  <div class="loomhaus-hero__stat-value">{{ block.settings.value }}</div>
                  <div class="loomhaus-hero__stat-label">{{ block.settings.label }}</div>
                </div>
              {%- endfor -%}
            {%- else -%}
              <!-- Default Mockup Stats -->
              <div class="loomhaus-hero__stat-item">
                <div class="loomhaus-hero__stat-value">{{ section.settings.stat_1_value | default: '4.8★' }}</div>
                <div class="loomhaus-hero__stat-label">{{ section.settings.stat_1_label | default: '2,000+ reviews' }}</div>
              </div>
              <div class="loomhaus-hero__stat-item">
                <div class="loomhaus-hero__stat-value">{{ section.settings.stat_2_value | default: '100%' }}</div>
                <div class="loomhaus-hero__stat-label">{{ section.settings.stat_2_label | default: 'organic cotton' }}</div>
              </div>
              <div class="loomhaus-hero__stat-item">
                <div class="loomhaus-hero__stat-value">{{ section.settings.stat_3_value | default: '30 days' }}</div>
                <div class="loomhaus-hero__stat-label">{{ section.settings.stat_3_label | default: 'free returns' }}</div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

      </div>

      <!-- Right Column: Visual Arched Showcase & Big Backdrop Effect -->
      <div class="loomhaus-hero__visual">
        <div class="loomhaus-hero__arch-composition">
          
          <!-- Big Circular Backdrop Effect (visible prominently behind photo on right) -->
          <div class="loomhaus-hero__arch-backdrop" aria-hidden="true"></div>

          <!-- Main Foreground Image Arch (Decreased size & sleek proportions) -->
          <div class="loomhaus-hero__arch-frame">
            {%- if section.settings.image != blank -%}
              <img 
                src="{{ section.settings.image | image_url: width: 800 }}" 
                alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
                loading="eager"
                width="370"
                height="470"
                class="loomhaus-hero__image"
              >
            {%- else -%}
              <img 
                src="{{ 'loomhaus-model.jpg' | asset_url }}" 
                alt="The Winter Edit Collection Model"
                loading="eager"
                width="370"
                height="470"
                class="loomhaus-hero__image"
              >
            {%- endif -%}
          </div>

          <!-- Floating Product Badge: Clickable to open the product directly -->
          {%- if section.settings.show_product_badge -%}
            {%- liquid
              assign all_store_prods = collections.all.products
              assign badge_product = section.settings.badge_product

              # Auto-resolve real product from store if not manually selected
              if badge_product == blank and all_store_prods.size > 0
                for p in all_store_prods
                  assign p_name = p.title | downcase
                  if p_name contains 'bag'
                    assign badge_product = p
                    break
                  endif
                endfor
                if badge_product == blank
                  for p in all_store_prods
                    assign p_name = p.title | downcase
                    if p_name contains 'black'
                      assign badge_product = p
                      break
                    endif
                  endfor
                endif
                if badge_product == blank
                  assign badge_product = all_store_prods.first
                endif
              endif

              # Resolve Title, URL, and Thumbnail
              # Default values strictly match Image 1 (Yellow Wool Jumper with the model photo)
              # Destination URL matches Image 2 (Classic Varsity Top showcase or product)
              if badge_product != blank
                assign badge_url = badge_product.url
                assign badge_title = section.settings.badge_title | default: badge_product.title
                assign prod_img = badge_product.featured_image | default: badge_product.featured_media.preview_image | default: badge_product.images.first
                if section.settings.badge_image != blank
                  assign badge_thumb_src = section.settings.badge_image | image_url: width: 120
                elsif prod_img != blank
                  assign badge_thumb_src = prod_img | image_url: width: 120
                else
                  assign badge_thumb_src = 'loomhaus-thumb.jpg' | asset_url
                endif
              else
                assign badge_url = section.settings.badge_link | default: '#featured-product-showcase'
                assign badge_title = section.settings.badge_title | default: 'Yellow Wool Jumper'
                if section.settings.badge_image != blank
                  assign badge_thumb_src = section.settings.badge_image | image_url: width: 120
                else
                  assign badge_thumb_src = 'loomhaus-thumb.jpg' | asset_url
                endif
              endif

              assign badge_sub = section.settings.badge_subtitle | default: 'Bestseller this week'
            -%}
            <a 
              href="{{ badge_url }}" 
              class="loomhaus-product-badge"
              title="Open product: {{ badge_title | escape }}"
              aria-label="Open product: {{ badge_title | escape }}"
              {% if section.settings.badge_new_tab %}target="_blank" rel="noopener"{% endif %}
              data-product-url="{{ badge_url }}"
            >
              <div class="loomhaus-product-badge__thumb">
                <img 
                  src="{{ badge_thumb_src }}" 
                  alt="{{ badge_title | escape }}"
                  width="34"
                  height="38"
                  loading="lazy"
                >
              </div>
              <div class="loomhaus-product-badge__info">
                <span class="loomhaus-product-badge__title">
                  {{ badge_title }}
                </span>
                <span class="loomhaus-product-badge__subtitle">
                  {{ badge_sub }}
                </span>
              </div>
              <span class="loomhaus-product-badge__arrow" aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}

        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Ticker / Marquee Banner -->
  {%- if section.settings.show_ticker -%}
    <div class="loomhaus-ticker" style="--ticker-duration: {{ section.settings.ticker_speed }}s;">
      <div class="loomhaus-ticker__track">
        {%- for i in (1..4) -%}
          <div class="loomhaus-ticker__content" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
            {%- assign ticker_blocks = section.blocks | where: 'type', 'ticker_item' -%}
            {%- if ticker_blocks.size > 0 -%}
              {%- for block in ticker_blocks -%}
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}" class="loomhaus-ticker__link">{{ block.settings.text }}</a>
                {%- else -%}
                  <span class="loomhaus-ticker__item">{{ block.settings.text }}</span>
                {%- endif -%}
                <span class="loomhaus-ticker__star" aria-hidden="true">✦</span>
              {%- endfor -%}
            {%- else -%}
              <!-- Default Mockup Ticker Items -->
              <span class="loomhaus-ticker__item">Organic cotton</span>
              <span class="loomhaus-ticker__star" aria-hidden="true">✦</span>
              <span class="loomhaus-ticker__item">Made to last</span>
              <span class="loomhaus-ticker__star" aria-hidden="true">✦</span>
              <span class="loomhaus-ticker__item">Sizes XS to L</span>
              <span class="loomhaus-ticker__star" aria-hidden="true">✦</span>
              <span class="loomhaus-ticker__item">Free returns</span>
              <span class="loomhaus-ticker__star" aria-hidden="true">✦</span>
              <span class="loomhaus-ticker__item">Ethically made</span>
              <span class="loomhaus-ticker__star" aria-hidden="true">✦</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

<script>
  // Ensure badge click reliably opens the product or scrolls smoothly to Image 2 (Classic Varsity Top)
  document.addEventListener('DOMContentLoaded', function() {
    const badges = document.querySelectorAll('.loomhaus-product-badge');
    badges.forEach(badge => {
      badge.addEventListener('click', function(e) {
        const showcase = document.getElementById('featured-product-showcase');
        const url = this.getAttribute('data-product-url') || this.getAttribute('href');
        
        if (url === '#featured-product-showcase' || (showcase && (!url || url === '#' || url === ''))) {
          e.preventDefault();
          if (showcase) {
            showcase.scrollIntoView({ behavior: 'smooth', block: 'start' });
            return;
          }
        }

        if (url && url !== '#' && url !== '#featured-product-showcase') {
          if (window.Shopify && window.Shopify.designMode) {
            e.preventDefault();
            window.open(url, '_blank');
          }
        }
      });
    });
  });
</script>

<style>
  .loomhaus-hero-wrapper {
    width: 100%;
    overflow: hidden;
  }

  .loomhaus-hero {
    width: 100%;
    position: relative;
    box-sizing: border-box;
  }

  .loomhaus-hero__container {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 48px;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 50px;
    position: relative;
  }

  /* Left Column: Content */
  .loomhaus-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    z-index: 2;
  }

  /* Pill Badge */
  .loomhaus-hero__badge-wrapper {
    margin-bottom: 24px;
  }

  .loomhaus-hero__badge {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  /* Headline */
  .loomhaus-hero__heading {
    font-size: clamp(42px, 5.5vw, 76px);
    font-weight: 850;
    line-height: 1.04;
    letter-spacing: -0.035em;
    margin: 0 0 24px 0;
    max-width: 480px;
  }

  /* Description */
  .loomhaus-hero__description {
    font-size: 16.5px;
    line-height: 1.6;
    margin: 0 0 32px 0;
    max-width: 460px;
    font-weight: 450;
  }

  .loomhaus-hero__description p {
    margin: 0;
  }

  /* CTA Button */
  .loomhaus-hero__action {
    margin-bottom: 50px;
  }

  .loomhaus-hero__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    border-radius: 9999px;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.25s ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  .loomhaus-hero__btn-arrow {
    display: inline-block;
    font-size: 16px;
    line-height: 1;
    transition: transform 0.22s ease;
  }

  .loomhaus-hero__btn:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.14);
  }

  .loomhaus-hero__btn:hover .loomhaus-hero__btn-arrow {
    transform: translateX(4px);
  }

  /* Stats Row */
  .loomhaus-hero__stats {
    display: flex;
    align-items: flex-start;
    gap: 38px;
    flex-wrap: wrap;
    padding-top: 8px;
  }

  .loomhaus-hero__stat-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .loomhaus-hero__stat-value {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .loomhaus-hero__stat-label {
    font-size: 13px;
    line-height: 1.3;
    font-weight: 450;
  }

  /* Right Column: Visual Arch Composition & Backdrop */
  .loomhaus-hero__visual {
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
    width: 100%;
  }

  .loomhaus-hero__arch-composition {
    position: relative;
    width: 100%;
    margin: 0 auto;
  }

  /* Big Circular Backdrop Effect (prominently visible behind photo) */
  .loomhaus-hero__arch-backdrop {
    position: absolute;
    top: 8px;
    border-radius: 50%;
    z-index: 1;
    opacity: 0.98;
    pointer-events: none;
    transition: all 0.3s ease;
  }

  /* Main Arch Frame: Decreased Size */
  .loomhaus-hero__arch-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 0.78 / 1;
    border-radius: 220px 220px 24px 24px;
    overflow: hidden;
    z-index: 2;
    box-shadow: 0 14px 38px rgba(0, 0, 0, 0.08);
    background-color: #E7E2D7;
  }

  .loomhaus-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    display: block;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .loomhaus-hero__arch-frame:hover .loomhaus-hero__image {
    transform: scale(1.035);
  }

  /* Floating Product Badge: Interactive Pill Card */
  .loomhaus-product-badge {
    position: absolute;
    bottom: 34px;
    left: -42px;
    z-index: 10;
    background: #FFFFFF;
    border-radius: 20px;
    padding: 8px 18px 8px 10px;
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: #191B18;
    cursor: pointer;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.11), 0 4px 12px rgba(0, 0, 0, 0.04);
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    border: 1px solid rgba(0, 0, 0, 0.04);
    user-select: none;
  }

  .loomhaus-product-badge:hover {
    transform: translateY(-3px) scale(1.025);
    box-shadow: 0 20px 44px rgba(0, 0, 0, 0.14), 0 6px 16px rgba(0, 0, 0, 0.06);
    border-color: rgba(0, 0, 0, 0.1);
  }

  .loomhaus-product-badge__thumb {
    width: 34px;
    height: 38px;
    border-radius: 10px;
    overflow: hidden;
    background: #F4EFEB;
    flex-shrink: 0;
  }

  .loomhaus-product-badge__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .loomhaus-product-badge__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    text-align: left;
  }

  .loomhaus-product-badge__title {
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.25;
    color: #191B18;
    transition: color 0.2s ease;
  }

  .loomhaus-product-badge:hover .loomhaus-product-badge__title {
    color: #4A5043;
  }

  .loomhaus-product-badge__subtitle {
    font-size: 11.5px;
    color: #74786E;
    line-height: 1.2;
    font-weight: 450;
  }

  .loomhaus-product-badge__arrow {
    display: inline-block;
    font-size: 14px;
    color: #74786E;
    opacity: 0.6;
    margin-left: 2px;
    transition: all 0.2s ease;
  }

  .loomhaus-product-badge:hover .loomhaus-product-badge__arrow {
    opacity: 1;
    transform: translateX(3px);
    color: #191B18;
  }

  /* Bottom Ticker / Marquee */
  .loomhaus-ticker {
    width: 100%;
    overflow: hidden;
    white-space: nowrap;
    display: flex;
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: 0.02em;
    position: relative;
    user-select: none;
  }

  .loomhaus-ticker__track {
    display: flex;
    width: max-content;
    animation: loomhausTickerScroll var(--ticker-duration, 28s) linear infinite;
  }

  .loomhaus-ticker:hover .loomhaus-ticker__track {
    animation-play-state: paused;
  }

  .loomhaus-ticker__content {
    display: flex;
    align-items: center;
    gap: 28px;
    padding-right: 28px;
    flex-shrink: 0;
  }

  .loomhaus-ticker__item,
  .loomhaus-ticker__link {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .loomhaus-ticker__link:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .loomhaus-ticker__star {
    font-size: 0.9em;
    user-select: none;
    opacity: 0.85;
  }

  @keyframes loomhausTickerScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  /* Responsive Breakpoints */
  @media (max-width: 1024px) {
    .loomhaus-hero__container {
      gap: 36px;
      padding: 0 32px;
    }
    .loomhaus-hero__stats {
      gap: 28px;
    }
    .loomhaus-product-badge {
      left: -20px;
      bottom: 24px;
    }
  }

  @media (max-width: 820px) {
    .loomhaus-hero__container {
      grid-template-columns: 1fr;
      gap: 48px;
      padding: 0 24px;
    }

    .loomhaus-hero__content {
      align-items: center;
      text-align: center;
    }

    .loomhaus-hero__heading {
      max-width: 100%;
    }

    .loomhaus-hero__description {
      max-width: 100%;
    }

    .loomhaus-hero__stats {
      justify-content: center;
      gap: 32px;
    }

    .loomhaus-hero__visual {
      margin-top: 10px;
    }

    .loomhaus-hero__arch-composition {
      max-width: 330px !important;
    }

    .loomhaus-hero__arch-backdrop {
      width: 380px !important;
      height: 380px !important;
      right: -30px !important;
    }

    .loomhaus-product-badge {
      left: 6px;
      bottom: 18px;
    }
  }

  @media (max-width: 480px) {
    .loomhaus-hero__container {
      padding: 0 18px;
    }

    .loomhaus-hero__stats {
      gap: 18px;
    }

    .loomhaus-hero__stat-value {
      font-size: 22px;
    }

    .loomhaus-hero__stat-label {
      font-size: 11.5px;
    }

    .loomhaus-hero__arch-composition {
      max-width: 290px !important;
    }

    .loomhaus-hero__arch-backdrop {
      width: 320px !important;
      height: 320px !important;
      right: -20px !important;
    }

    .loomhaus-product-badge {
      left: 4px;
      bottom: 14px;
      padding: 6px 14px 6px 8px;
    }

    .loomhaus-product-badge__thumb {
      width: 30px;
      height: 34px;
    }

    .loomhaus-product-badge__title {
      font-size: 12px;
    }

    .loomhaus-product-badge__subtitle {
      font-size: 10px;
    }
  }
</style>

{% schema %}
{
  "name": "Hero - The Winter Edit",
  "class": "loomhaus-hero-section",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Pill Badge"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show category badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "NEW SEASON • AUTUMN / WINTER"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Badge background",
      "default": "#63675F"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Badge text color",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Headings & Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main headline",
      "default": "The Winter Edit"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Headline color",
      "default": "#191B18"
